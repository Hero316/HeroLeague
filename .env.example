# Kopie dieser Datei als .env.local anlegen – oder besser: `vercel env pull .env.local`

# Neon Postgres (wird von der Vercel-Neon-Integration automatisch gesetzt)
DATABASE_URL=

# Vercel Blob (wird von der Vercel-Blob-Integration automatisch gesetzt)
BLOB_READ_WRITE_TOKEN=

# Admin-Login: langes, sicheres Passwort wählen (20+ Zeichen empfohlen)
ADMIN_PASSWORD=

# Session-Signierung: erzeugen mit `openssl rand -base64 32`
SESSION_SECRET=

# Zwei-Faktor fürs Master-Passwort: gesetzt ⇒ nach richtigem Passwort wird ein
# Code an diese Adresse geschickt (echte 2-Faktor-Anmeldung). Leer ⇒ Login wie
# bisher in einem Schritt. Benötigt konfigurierten Mailversand (RESEND_API_KEY + MAIL_FROM).
ADMIN_2FA_EMAIL=

# Interne Kopie jeder Season-Anmeldung (alle Angaben, schön formatiert) an diese
# Adresse. Mehrere durch Komma trennen. Leer ⇒ es wird ADMIN_2FA_EMAIL genutzt;
# ist auch die leer, geht keine interne Kopie raus.
SIGNUP_NOTIFY_EMAIL=

# Mailversand für Login-/2FA-Codes über Resend (https://resend.com)
RESEND_API_KEY=
# Absenderadresse der Login-Mails, z.B. "Hero League <login@hero-league.de>"
MAIL_FROM=

# Handy-Push (Web-Push). BEIDE Schlüssel erzeugen mit: npx web-push generate-vapid-keys
# Fehlt einer, verschickt der Server STILL nichts (App zeigt trotzdem „aktiv").
# Nach einem Wechsel der Schlüssel müssen sich alle Geräte neu anmelden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt-Adresse für Push-Dienste (Pflicht bei manchen Browsern), z.B. mailto:admin@hero-league.de
VAPID_SUBJECT=
