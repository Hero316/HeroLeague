# Kopie dieser Datei als .env.local anlegen – oder besser: `vercel env pull .env.local`

# Neon Postgres (wird von der Vercel-Neon-Integration automatisch gesetzt)
DATABASE_URL=

# Vercel Blob (wird von der Vercel-Blob-Integration automatisch gesetzt)
BLOB_READ_WRITE_TOKEN=

# Admin-Login: langes, sicheres Passwort wählen
ADMIN_PASSWORD=

# Session-Signierung: erzeugen mit `openssl rand -base64 32`
SESSION_SECRET=
